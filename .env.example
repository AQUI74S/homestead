# homestead configuration. Copy to .env and fill in:  cp .env.example .env
# Every setting of the app and of docker-compose.yml lives here.

# --- Web UI -------------------------------------------------------------------
# Host name you open the app with; Caddy issues the HTTPS certificate for it.
HS_DOMAIN=localhost
# Public URL of the app (redirect target after the bank login).
# Leave empty to use https://$HS_DOMAIN.
HS_PUBLIC_URL=
# Login password. Empty = no login (only for local testing!).
HS_PASSWORD=change-me
# Random key for login cookies, at least 32 characters:  openssl rand -hex 32
HS_SESSION_KEY=
# Bank sync interval (minimum 1h; PSD2 allows 4 unattended fetches per day and account).
HS_SYNC_INTERVAL=6h
# true = simulated bank with sample data for both areas (no Enable Banking needed).
HS_DEMO=false

# --- Enable Banking -----------------------------------------------------------
# Application ID from the Enable Banking control panel. The private key goes to
# $HS_DATA_DIR/secrets/enablebanking.pem.
EB_APP_ID=
# Country for the bank list.
EB_COUNTRY=DE
EB_API_BASE=https://api.enablebanking.com

# --- Database -----------------------------------------------------------------
POSTGRES_USER=homestead
POSTGRES_PASSWORD=change-me
POSTGRES_DB=homestead

# --- Docker -------------------------------------------------------------------
# Image to run (tags: latest, a release like 1.2.3, or sha-<commit>).
HS_IMAGE=ghcr.io/aqui74s/homestead:latest
# Directory for all persistent data: db/, caddy/ (certificates), secrets/.
# Use an absolute path when deploying via Portainer.
HS_DATA_DIR=./data
# Ports published on the host.
HS_HTTP_PORT=8080
HS_HTTPS_PORT=443

# --- Optional: own IP in the LAN (docker-compose.static-ip.yml) ---------------
# Name of an existing macvlan/ipvlan Docker network and the IP for homestead.
HS_LAN_NETWORK=
HS_LAN_IP=
